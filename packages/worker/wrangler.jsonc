{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liars-deck-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_DO",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomDurableObject"
      ]
    }
  ],
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS"
  }
}
